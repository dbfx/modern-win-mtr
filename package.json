{
  "name": "modern-win-mtr",
  "productName": "Modern MTR",
  "version": "1.5.0",
  "description": "A beautiful, modern MTR (My Traceroute) tool built with Electron, React, and TypeScript",
  "main": ".vite/build/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/dbfx/modern-win-mtr.git"
  },
  "author": "dbfx",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dbfx/modern-win-mtr/issues"
  },
  "homepage": "https://github.com/dbfx/modern-win-mtr#readme",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "generate-icons": "node scripts/generate-icon.mjs",
    "make": "npm run generate-icons && electron-forge make",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "release:patch": "standard-version --release-as patch",
    "release:first": "standard-version --first-release",
    "prepare": "husky"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.8.9",
    "framer-motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-simple-maps": "^3.0.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-simple-maps": "^3.0.6",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "42.11.16",
    "husky": "^9.1.7",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.35.5",
    "standard-version": "^9.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^8.3.4"
  }
}
